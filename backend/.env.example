# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL (target):  postgresql+psycopg://finpilot:password@localhost:5432/finpilot
# SQLite (dev fallback, used when this is unset): sqlite:///../data/finpilot.db
DATABASE_URL=

# Optional. Without it the app runs on the deterministic fallback router and template narration.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
# Set to true to force the keyword fallback router even when a key is present (demo/testing).
FORCE_FALLBACK_ROUTER=false

# Optional. Reads handwritten notes with Google Gemini when Tesseract finds no printed text.
# Free key: https://aistudio.google.com -> "Get API key". Leave empty to keep handwriting off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.45
